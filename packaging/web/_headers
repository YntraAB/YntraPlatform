# Cloudflare Pages / Edge CDN Headers Configuration for Yntra Platform

/*
  # Required COOP & COEP headers for SharedArrayBuffer & OPFS SQLite WASM thread isolation
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-site
  
  # SSL Termination & HSTS enforcement
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # Web Security Headers
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Immutable caching for compiled WASM binaries & JS bundles
/*.wasm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm

/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Service Worker - Always revalidate
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
