# Yntra Platform Environment Configuration

# Local-First Platform Administrator Whitelist Email
# The email specified here will be automatically registered as a platform_admin in the local SQLite database on boot.
ADMIN_EMAIL="admin@yntra.se"

# libSQL Database Replication (Optional)
# LIBSQL_URL="libsql://your-db-name.turso.io"
# LIBSQL_AUTH_TOKEN="your-turso-token"

# Security Configuration for Local Development (Optional)
# Insecure development mode: allows bypassing role signature checks in debug builds only when workspace public key is empty
# YNTRA_INSECURE_DEV_BYPASS_SIGNATURES=true

# BankID mock PIN bypass: allows mock logins in debug builds (e.g. mock_admin, 123456)
# YNTRA_ALLOW_BANKID_MOCK_PIN_BYPASS=true

